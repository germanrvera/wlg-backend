# Production environment variables for Railway/Render
# Don't commit this file, use the platform's environment variable settings instead

SECRET_KEY=your-secret-key-generate-with-python-secrets
DEBUG=False
ALLOWED_HOSTS=yourdomain.railway.app,yourdomain.render.com,wlgled.com.ar

# Database - PostgreSQL (provided by Railway/Render)
DATABASE_URL=postgresql://user:password@host:port/dbname

# HTTPS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
